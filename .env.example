# Coolify MCP Server Configuration
# Copy this file to .env and fill in your values

# Coolify API Configuration
# Get your API key from Coolify Dashboard -> Settings -> API Keys
COOLIFY_API_KEY=your_api_key_here

# Coolify Server URL (default: http://localhost:3000)
COOLIFY_API_URL=http://localhost:3000

# API Version (default: v1)
COOLIFY_API_VERSION=v1

# Response truncation limit (characters, default: 10000)
CHARACTER_LIMIT=10000

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Request timeout in milliseconds (default: 30000)
REQUEST_TIMEOUT=30000