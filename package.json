{
  "name": "coolify-mcp-server",
  "version": "1.0.0",
  "description": "MCP (Model Context Protocol) Server for Coolify - Self-hosted PaaS platform for managing applications, databases, and services",
  "main": "dist/server.js",
  "bin": {
    "coolify-mcp-server": "./dist/server.js",
    "coolify-cli": "./bin/coolify-cli.js"
  },
  "type": "module",
  "files": [
    "dist/",
    "bin/",
    "README.md",
    ".env.example",
    ".CoolifyDocs/"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "cli": "node bin/coolify-cli.js",
    "dev": "ts-node src/server.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "node dist/server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coolify",
    "docker",
    "deployment",
    "paas",
    "devops",
    "cli",
    "ide-integration",
    "direct-api"
  ],
  "author": "Coolify Plugin Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.0",
    "ts-node": "^10.9.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cthiam23-collab/coolify-mcp-server.git"
  },
  "config": {
    "prettier": {
      "semi": true,
      "singleQuote": true,
      "trailingComma": "es5",
      "tabWidth": 2,
      "useTabs": false
    }
  }
}